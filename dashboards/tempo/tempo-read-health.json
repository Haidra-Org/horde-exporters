{
  "uid": "horde-tempo-read-health",
  "title": "Horde Tempo Read and Cache Health",
  "description": "Compare Tempo metadata caching, time-bounded lookup costs and worker-cap effects without adding trace queries. Infrastructure org only; relies on staged ops-tempo-read-* rules and node textfile metrics.",
  "tags": [
    "horde",
    "infrastructure",
    "tempo",
    "cache"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Read tuning: configured intent and observed health",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "text",
      "title": "How to judge the change",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Compare equal lookup volume and similar time ranges. Good: warm metadata hits \u226580%, fewer backend GETs/lookup, p95 <10s, no 5xx/404 regression, no shared-cache evictions or Mimir degradation. Bad: missing cache counters despite traffic, errors/oversize skips, sustained work beyond the worker cap, or unchanged read cost. Budgets are initial review thresholds, not guaranteed savings. NO DATA is unknown, never healthy. Cache-effectiveness warnings wait 30 minutes after Tempo starts. Stats need the staged node textfile collectors; rules need ops-tempo-read-* in the infrastructure tenant. This dashboard queries metrics only and makes no Tempo trace lookups."
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Configured cache (0 disabled, 1 expected)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-infra"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(horde_tempo_cache_expected)",
          "legendFormat": "cache expected",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "range": false,
          "instant": true
        }
      ]
    },
