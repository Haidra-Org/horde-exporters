    {
      "id": 8,
      "type": "timeseries",
      "title": "GETs per lookup: current and previous day",
      "description": "Aggregate attribution estimate. Background compaction and different trace age can change the ratio. Only shown with \u226530 lookups/15m.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-infra"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 200
              }
            ]
          },
          "custom": {
            "thresholdsStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tempodb_backend_request_duration_seconds_count{job=\"tempo\",operation=\"GET\"}[5m])) / clamp_min(sum(rate(tempo_request_duration_seconds_count{job=\"tempo\",route=~\"api(_v2)?_traces_traceid\"}[5m])), 1e-9) and on() (sum(increase(tempo_request_duration_seconds_count{job=\"tempo\",route=~\"api(_v2)?_traces_traceid\"}[15m])) >= 30)",
          "legendFormat": "current",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(tempodb_backend_request_duration_seconds_count{job=\"tempo\",operation=\"GET\"}[5m] offset 1d)) / clamp_min(sum(rate(tempo_request_duration_seconds_count{job=\"tempo\",route=~\"api(_v2)?_traces_traceid\"}[5m] offset 1d)), 1e-9) and on() (sum(increase(tempo_request_duration_seconds_count{job=\"tempo\",route=~\"api(_v2)?_traces_traceid\"}[15m] offset 1d)) >= 30)",
          "legendFormat": "1 day earlier",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "range": true,
          "instant": false
        }
      ]
    },
