{
  "uid": "horde-anomalous-activity",
  "title": "Horde Anomalous Activity",
  "tags": [
    "horde",
    "ai-horde",
    "abuse"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "horde_overlay": "alerts-infra",
        "name": "Infra alerts",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-infra"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#d03b3b",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\", alertname!~\"Watchdog|HostSystemdServiceFailed|HostOutOfInodes|HostSwapFillingUp|HostDiskWillFillIn24h|HostDiskUsageHigh|WireGuardTextfileStale|PrometheusTargetsMissing|HordeRequestObservationDataReady|HordeRequestEstimatorPromotionApproved|HordeRequestUnstartedExpiryForecastValidationReady\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{instance}}{{host}}{{peer}}{{proxy}}{{name}}",
        "useValueForTime": false
      },
      {
        "horde_overlay": "alerts-telemetry",
        "name": "App alerts (telemetry)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-telemetry"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#ec835a",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\", alertname!~\"Watchdog|HostSystemdServiceFailed|HostOutOfInodes|HostSwapFillingUp|HostDiskWillFillIn24h|HostDiskUsageHigh|WireGuardTextfileStale|PrometheusTargetsMissing|HordeRequestObservationDataReady|HordeRequestEstimatorPromotionApproved|HordeRequestUnstartedExpiryForecastValidationReady\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{horde_host}}{{horde_job_name}}{{deployment_environment_name}}",
        "useValueForTime": false
      },
      {
        "horde_overlay": "alerts-app",
        "name": "App alerts (exporter)",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir-app"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#e0b400",
        "expr": "ALERTS{alertstate=\"firing\", severity=~\"critical|warning\", alertname!~\"Watchdog|HostSystemdServiceFailed|HostOutOfInodes|HostSwapFillingUp|HostDiskWillFillIn24h|HostDiskUsageHigh|WireGuardTextfileStale|PrometheusTargetsMissing|HordeRequestObservationDataReady|HordeRequestEstimatorPromotionApproved|HordeRequestUnstartedExpiryForecastValidationReady\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "useValueForTime": false
      },
      {
        "horde_overlay": "app-restarts",
        "name": "App restarts",
        "datasource": {
          "type": "loki",
          "uid": "loki-app"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#8ab8ff",
        "expr": "{app=\"ai-horde\", component=\"backend\"} |= \"INIT\" |= \"Horde Database\" | line_format \"{{.instance}} {{.container}} started\""
      },
      {
        "horde_overlay": "operator",
        "name": "Operator notes & deploys",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#b877d9",
        "target": {
          "type": "tags",
          "tags": [
            "ai-horde"
          ],
          "matchAny": true,
          "limit": 200
        }
      }
    ]
  },
  "description": "Signals for scripted or abusive traffic: per-model demand against its own history, the monthly ranking that \"top N\" workers load from, per-client edge activity and anonymous-requester concentration. Org 1 only. Edge and anonymous panels read Loki recording-rule series in Mimir (see README); the IP table reads Loki directly.",
  "panels": [
    {
      "type": "row",
      "title": "Model demand \u2014 name-agnostic (the statistic worker \"top N\" selection reads)",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Images per model, rolling day (top 8)",
      "description": "The horde's rolling 24h image count per model. A scripted campaign shows as one model pulling away from its usual level.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-app"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "topk(8, max by (model) (horde_stats_model_images_generated{period=\"day\"}))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Day count \u00f7 14-day median",
      "description": "Each model's rolling daily image count divided by its own 14-day median (hourly samples). Sustained values above 2 on a high-volume model mean demand has jumped: a new model or client release, or scripted traffic. Models under 2k images/day are hidden.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-app"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "topk(8, (max by (model) (horde_stats_model_images_generated{period=\"day\"}) / clamp_min(quantile_over_time(0.5, (max by (model) (horde_stats_model_images_generated{period=\"day\"}))[14d:1h]), 1)) and on (model) (max by (model) (horde_stats_model_images_generated{period=\"day\"}) > 2000))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Monthly ranking (what \"top N\" workers load)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-app"
      },
      "description": "Month image counts per model. Workers configured with \"top N\" load from the top of this list, so inflating it diverts volunteer GPUs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "text",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "sort_desc(topk(10, max by (model) (horde_stats_model_images_generated{period=\"month\"})))",
          "legendFormat": "{{model}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Workers serving the month's top 5 models",
      "description": "Online image workers per model, for the five most-generated models this month.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-app"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "max by (model) (horde_model_workers_count{type=\"image\"}) and on (model) topk(5, max by (model) (horde_stats_model_images_generated{period=\"month\"}))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Clients at the edge (edge HAProxy request logs with Client-Agent capture; recorded per minute)",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Image submissions by client family (top 10)",
      "description": "POST /api/v2/generate/async per Client-Agent name and interval, all statuses, from the per-minute edge recording (top 50 clients per minute). \"(none)\" means no Client-Agent header. A new name near the top with no history deserves a closer look at its request settings and prompts.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-infra"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "expr": "topk(10, sum by (client) (sum_over_time(horde:edge_image_submissions:count1m[$__interval])))",
          "legendFormat": "{{client}}",
          "refId": "A"
        }
      ],
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Rejected (4xx) image submissions by client family (top 10)",
      "description": "Image submissions answered with a 4xx at the edge, per client name and interval. Blocked, rate-limited or malformed clients appear here; compare with the accepted volume on the left.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-infra"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "expr": "topk(10, sum by (client) (sum_over_time(horde:edge_image_submissions:count1m{status_class=\"4xx\"}[$__interval])))",
          "legendFormat": "{{client}}",
          "refId": "A"
        }
      ],
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "Status polls by client family (top 10)",
      "description": "GET /api/v2/generate/status per client name and interval. The status call returns finished images and is the expensive poll; a client polling many times per submission multiplies its edge and API cost.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-infra"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "expr": "topk(10, sum by (client) (sum_over_time(horde:edge_status_polls:count1m[$__interval])))",
          "legendFormat": "{{client}}",
          "refId": "A"
        }
      ],
      "interval": "1m"
    },
    {
      "type": "timeseries",
      "title": "All image submissions by status class, and status polls",
      "description": "Untruncated edge totals per interval: image submissions by status class, and all status polls.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-infra"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "expr": "sum by (status_class) (sum_over_time(horde:edge_image_submissions_all:count1m[$__interval]))",
          "legendFormat": "submissions {{status_class}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-infra"
          },
          "expr": "sum(sum_over_time(horde:edge_status_polls_all:count1m[$__interval]))",
          "legendFormat": "status polls",
          "refId": "B"
        }
      ],
      "interval": "1m"
    },
    {
      "type": "row",
      "title": "Anonymous requesters (application logs; shows IP addresses \u2014 keep this dashboard out of public orgs)",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Top anonymous IP subjects by delivered generations (last 15 minutes)",
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki-app"
      },
      "description": "From the 'requesting user Anonymous#0 [ip]' settlement log line, image and text. IPv4 addresses are shown whole and IPv6 as its first four hextets (the /64); compressed IPv6 addresses are shown whole. Fixed 15-minute window: Loki's per-query series limit (default 500) counts every subject before topk, and an hour already exceeds it.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Generations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "subject"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "displayName",
                "value": "Subject"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Generations",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (subject) (count_over_time({app=\"ai-horde\", component=\"backend\"} |= \"(requesting user Anonymous#0 [\" | regexp \"Anonymous#0 \\\\[(?P<subject>[0-9]+\\\\.[0-9]+\\\\.[0-9]+\\\\.[0-9]+|[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}:[0-9a-f]{1,4}|[0-9a-f:.]+)\" [15m])))",
          "legendFormat": "{{subject}}",
          "refId": "A",
          "queryType": "instant"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Anonymous generations delivered",
      "description": "All anonymous image and text generations settled per interval, from the 5-minute recording.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-app"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "sum(sum_over_time(horde:anon_generations:count5m[$__interval]))",
          "legendFormat": "anonymous generations",
          "refId": "A"
        }
      ],
      "interval": "5m"
    },
    {
      "type": "timeseries",
      "title": "Anonymous sources per 5 minutes, and the busiest one",
      "description": "Distinct anonymous IP subjects (IPv4 address or IPv6 /64) per 5 minutes, and how many generations the busiest one settled. No addresses are recorded; use the table on the left for who it is right now. A busiest-source line far above its usual level means one source is driving anonymous volume.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "mimir-app"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "max(horde:anon_subjects:count5m)",
          "legendFormat": "distinct IP subjects",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir-app"
          },
          "expr": "max(horde:anon_top_subject_generations:max5m)",
          "legendFormat": "busiest subject's generations",
          "refId": "B"
        }
      ],
      "interval": "5m"
    }
  ],
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "horde"
      ],
      "targetBlank": false,
      "title": "Horde Dashboards",
      "type": "dashboards"
    }
  ]
}
