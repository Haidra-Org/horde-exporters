     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "expr": "sum(increase(horde_style_applications{deployment_environment_name=~\"$environment\", horde_dry_run=\"true\"}[$__range]))",
     "refId": "A",
