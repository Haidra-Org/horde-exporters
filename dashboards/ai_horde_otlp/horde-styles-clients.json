    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "expr": "sum(increase(horde_style_applications{deployment_environment_name=~\"$environment\", horde_dry_run=\"false\", horde_gentype=\"image\"}[$__range])) / clamp_min(sum(increase(horde_generate_duration_count{deployment_environment_name=~\"$environment\", horde_gentype=\"image\"}[$__range])), 1)",
     "refId": "A",
