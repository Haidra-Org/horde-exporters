    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "expr": "sum(increase(horde_style_applications{deployment_environment_name=~\"$environment\", horde_dry_run=\"false\", horde_style_source=\"collection\"}[$__range])) / clamp_min(sum(increase(horde_style_applications{deployment_environment_name=~\"$environment\", horde_dry_run=\"false\"}[$__range])), 1)",
