  },
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 25
   },
   "id": 14,
   "title": "Who uses styles (app logs, queued requests only)",
   "type": "row"
  },
  {
   "datasource": {
    "type": "loki",
    "uid": "loki-app"
   },
   "description": "Client name (first Client-Agent field) on 'Style applied:' lines over the range. Only queued requests are logged at info; dry runs are logged at debug and not shipped. Filter by host with $host.",
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "align": "auto"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "desc": true,
      "displayName": "styled requests"
     }
    ],
    "footer": {
     "show": false
    }
   },
   "targets": [
    {
     "expr": "topk(25, sum by (client) (count_over_time({app=\"ai-horde\", instance=~\"$host\"} |= \"Style applied:\" | regexp \"agent '(?P<client>[^':]*)\" | label_format client=`{{ if .client }}{{ .client }}{{ else }}(empty){{ end }}` [$__range])))",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table",
     "queryType": "instant"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "Value": "styled requests"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "styled requests",
        "desc": true
       }
      ]
     }
    }
   ],
   "title": "Clients applying styles",
   "type": "table",
   "gridPos": {
