 "description": "AI Horde kudos accounting subsystem: deferred-ledger projector (applier) health, admission holds/reservations, economy events (floor adjustments, idempotent replays) and Postgres context. Datasources: app OTLP metrics on mimir-telemetry (ai-horde-telemetry tenant), postgres_exporter on mimir-infra (infrastructure tenant), audit logs on loki-app (ai-horde-app tenant). The applier and reservation gauges are emitted only by the quorum node, so these panels read \"No data\" rather than zero when that node is not exporting telemetry. Org 1 infra dashboard.",
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 1,
 "id": null,
 "links": [
  {
   "asDropdown": true,
   "icon": "external link",
   "includeVars": true,
   "keepTime": true,
   "tags": [
    "horde"
   ],
   "targetBlank": false,
   "title": "Horde Dashboards",
   "type": "dashboards"
  }
 ],
 "panels": [
  {
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 100,
   "title": "Projector Health",
   "type": "row"
  },
  {
   "datasource": {
    "type": "prometheus",
    "uid": "mimir-telemetry"
   },
   "description": "Age of the oldest unfolded ledger row (per-tick histogram, avg over 2m). Green under 15s; amber 15-30s; red over 30s matches the heartbeat DEGRADED trip. On red, the projector is not draining pending rows: check applier lag and saturation below and confirm the applier task is alive. Reads \"No data\" when the quorum node is not exporting telemetry, which is not the same as a healthy zero.",
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "unit": "s",
     "noValue": "No data",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 15
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     }
    },
    "overrides": []
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "id": 1,
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "textMode": "auto",
    "colorMode": "background",
    "graphMode": "area"
   },
   "targets": [
    {
     "expr": "rate(horde_kudos_oldest_pending_sum[2m]) / rate(horde_kudos_oldest_pending_count[2m])",
     "legendFormat": "oldest pending",
     "refId": "A"
    }
   ],
   "title": "Oldest Pending Age",
   "type": "stat"
  },
